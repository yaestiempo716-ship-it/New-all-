# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Leave the Google values empty to run in DEMO MODE (data kept in memory, not saved).

# From your Google service account JSON key ("client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same JSON key ("private_key"). Paste it in quotes, keeping the \n parts.
GOOGLE_PRIVATE_KEY=

# The long ID in your sheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Password for /admin. Use something long.
ADMIN_PASSWORD=
